# The shop API's settings on the server. Copy to ~/ecommerce/.env and fill in. Never commit the filled-in file.

# The API's public name (a DNS A record, or an sslip.io name, pointing at this server). Caddy gets its HTTPS certificate.
API_DOMAIN=shop-api.example.com

# The image CI builds. CI also writes this line on every deploy.
API_IMAGE=ghcr.io/OWNER/raaves-shop-api:latest

# The database password (letters and digits only, so it fits in a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Signs the sign-in tokens, at least 32 characters:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# This API's public address (https:// and API_DOMAIN), and the website's.
PUBLIC_URL=https://shop-api.example.com
SITE_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

# Email through the shop's Zoho mailbox (README.md, step 2); MAIL_FROM must be that mailbox. ADMIN_EMAIL gets a copy of
# every paid order. (Or, with SMTP_HOST empty, Resend: RESEND_API_KEY and a MAIL_FROM on a domain verified there.)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@christmasraave.in
SMTP_PASSWORD=
MAIL_FROM=Raave's Evergreen <info@christmasraave.in>
ADMIN_EMAIL=
RESEND_API_KEY=

# Razorpay: API keys (test keys first, then live) and the webhook's secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The admin login the first `seed` makes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
