# Copy to .env and fill in. .env is not committed.

# development | test | production. In production the interactive docs (/docs) are switched off.
ENVIRONMENT=development

# The shop database. On a computer whose PostgreSQL user can't create databases, a schema in an existing one works:
#   postgresql+psycopg://user:password@localhost:5432/some_db?options=-csearch_path%3Dshop   (CREATE SCHEMA shop first)
DATABASE_URL=postgresql+psycopg://shop:CHANGE_ME@localhost:5432/raaves_shop

# A separate database (or schema) the tests create their tables in and wipe; never your real one.
TEST_DATABASE_URL=postgresql+psycopg://shop:CHANGE_ME@localhost:5432/raaves_shop_test

# A long random string (at least 32 characters); it signs the sign-in tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# The website's address(es), comma-separated; this API's own address (photo links); the website's (email links).
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:8001
SITE_URL=http://localhost:5173

# Email: a mailbox's SMTP server (the shop uses its Zoho mailbox: smtp.zoho.in, 465), or else Resend (resend.com: the API
# key and a sender on a domain verified there). With neither, emails go to the log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=Raave's Evergreen <no-reply@mail.example.com>
# Optional: where customers' replies go (the shop's own inbox).
MAIL_REPLY_TO=
# Optional: an inbox that gets a copy of every paid order.
ADMIN_EMAIL=

# Razorpay (Dashboard -> Account & Settings -> API keys; test keys start rzp_test_). Without them, online payment is off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Dashboard -> Webhooks) for payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=

# The admin login `python -m app.cli seed` makes when there is none (it never changes an existing one).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
