# The server's settings. Copy to ~/billing/.env on the server and fill in. Never commit the filled-in file.

# The API's public address (a DNS A record pointing at the server). Caddy gets its HTTPS certificate for it.
API_DOMAIN=api.example.com

# The website's shop API address (ecommerce/deploy), a second name for this server. Caddy gets its certificate too.
SHOP_API_DOMAIN=shop-api.example.com

# The image CI builds. CI also writes this line on every deploy.
API_IMAGE=ghcr.io/OWNER/raaves-billing-api:latest

# The database password (letters and digits only, so it fits in a URL). Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Signs the login tokens; at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# The billing frontend's address(es), comma-separated (the Cloudflare Pages address and/or your own domain).
CORS_ORIGINS=https://billing.example.com

TOKEN_HOURS=14
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15

# The Demo button on the sign-in screen. Keep it off on the live server.
DEMO_ENABLED=false
