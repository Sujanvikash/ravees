# Copy to .env and fill in. .env is not committed.

# development | test | production. In production the interactive docs (/docs) are switched off.
ENVIRONMENT=development

# The billing database on your local PostgreSQL (see README: "Set up the database").
DATABASE_URL=postgresql+psycopg://billing:CHANGE_ME@localhost:5432/raaves_billing

# A long random string (at least 32 characters); it signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# How long a login lasts, in hours (a counter shift plus margin).
TOKEN_HOURS=14

# Where the API's routes live. The billing frontend's VITE_API_URL ends with this.
API_PREFIX=/api/v1

# The billing frontend's address(es), comma-separated.
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# Wrong passwords allowed for one login from one computer before sign-in pauses, and over how many minutes.
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15

# A separate database the tests create tables in and wipe; never your real one. Leave it out to skip the API tests.
TEST_DATABASE_URL=postgresql+psycopg://billing:CHANGE_ME@localhost:5432/raaves_billing_test

# The Demo switch on the sign-in screen: the same logins on sample data (python -m app.cli demo). false turns it off.
DEMO_ENABLED=true
